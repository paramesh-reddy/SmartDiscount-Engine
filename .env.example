# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Neon PostgreSQL connection string (keep real credentials in .env only)
DATABASE_URL="YOUR_NEON_POSTGRESQL_CONNECTION_STRING"

# JWT Secrets for authentication (override in production)
JWT_SECRET="change-me-in-production-access-secret"
JWT_REFRESH_SECRET="change-me-in-production-refresh-secret"

# AI model configuration
GEMINI_CHAT_MODEL="gemini-4-hydrogen"
GEMINI_EMBEDDING_MODEL="gemini-embedding-2"
